---
import Icon from './Icon.astro';
import { PROJECT_TYPES, bookingHref } from '../data/site.js';
const { lang, t } = Astro.props;
const c = t.contact;
const f = c.fields;
const book = bookingHref(lang, true);
---
<section id="contact" class="section section--deep contact" aria-labelledby="contact-title">
  <svg class="contact__bore" viewBox="0 0 1200 300" preserveAspectRatio="none" aria-hidden="true">
    <path class="contact__bore-path" d="M -20 60 C 220 60, 300 230, 600 230 S 980 60, 1220 60" pathLength="100" />
  </svg>
  <div class="container">
    <div class="contact__head reveal">
      <h2 class="h1 contact__title" id="contact-title">{c.title}</h2>
      <p class="lead contact__sub">{c.sub}</p>
    </div>

    <div class="contact__card reveal">
      <div class="contact__intro">
        <h3 class="h3">{c.formTitle}</h3>
        <p>{c.formLead}</p>
      </div>
      <!-- PROVISÓRIO: o destino do formulário (e-mail, CRM ou webhook) ainda não foi definido. Ver memoria.md. -->
      <!-- Campos iguais aos do formulário do site atual. -->
      <form class="form" data-form novalidate>
        <input type="hidden" name="language" value={lang} />
        <div class="field">
          <label for="f-name">{f.name.label}</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required />
          <p class="field__error" data-error-for="f-name">{f.name.error}</p>
        </div>
        <div class="field">
          <label for="f-company">{f.company.label}</label>
          <input id="f-company" name="company" type="text" autocomplete="organization" required />
          <p class="field__error" data-error-for="f-company">{f.company.error}</p>
        </div>
        <div class="field">
          <label for="f-phone">{f.phone.label}</label>
          <input id="f-phone" name="phone" type="tel" autocomplete="tel" required />
          <p class="field__error" data-error-for="f-phone">{f.phone.error}</p>
        </div>
        <div class="field">
          <label for="f-email">{f.email.label}</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required />
          <p class="field__error" data-error-for="f-email">{f.email.error}</p>
        </div>
        <div class="field">
          <label for="f-state">{f.state.label}</label>
          <input id="f-state" name="state" type="text" autocomplete="address-level1" required />
          <p class="field__error" data-error-for="f-state">{f.state.error}</p>
        </div>
        <div class="field">
          <label for="f-type">{f.projectType.label}</label>
          <select id="f-type" name="projectType" required data-project-select>
            <option value="">{f.projectType.placeholder}</option>
            {PROJECT_TYPES.map((pt) => <option value={pt}>{c.projectTypes[pt]}</option>)}
          </select>
          <p class="field__error" data-error-for="f-type">{f.projectType.error}</p>
        </div>
        <div class="field">
          <label for="f-crews">{f.crews.label} <span class="field__opt">{c.optional}</span></label>
          <input id="f-crews" name="crews" type="text" inputmode="numeric" />
        </div>
        <div class="field field--full">
          <label for="f-msg">{f.details.label} <span class="field__opt">{c.optional}</span></label>
          <textarea id="f-msg" name="details" rows="4"></textarea>
        </div>
        <div class="field--full form__foot">
          <button class="btn btn--primary" type="submit">{t.ui.requestSupport}<Icon name="arrow" /></button>
          <p class="form__status" role="status" aria-live="polite" data-form-status></p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact { overflow: hidden; }
  .contact__bore { position: absolute; left: 0; top: 40px; width: 100%; height: 300px; pointer-events: none; }
  .contact__bore-path { fill: none; stroke: var(--primary); stroke-width: 2; stroke-dasharray: 100; stroke-dashoffset: 100; opacity: .55; vector-effect: non-scaling-stroke; transition: stroke-dashoffset 2.4s var(--ease-out); }
  .contact.is-in .contact__bore-path { stroke-dashoffset: 0; }
  .contact .container { position: relative; }
  .contact__head { display: grid; justify-items: center; text-align: center; gap: 32px; max-width: 980px; margin: 0 auto clamp(48px, 7vw, 88px); }
  .contact__title { font-size: clamp(28px, 4.6vw, 60px); }
  .contact__sub { max-width: 40em; color: var(--on-dark-2); }

  .contact__card { background: var(--white); color: var(--text); border-radius: var(--r-lg); padding: clamp(24px, 4vw, 48px); display: grid; grid-template-columns: 4fr 8fr; gap: clamp(24px, 4vw, 56px); }
  .contact__intro { display: grid; gap: 12px; align-content: start; color: var(--text-2); }
  .contact__intro .h3 { color: var(--text); font-size: clamp(22px, 2.2vw, 28px); }

  @media (max-width: 1023px) { .contact__card { grid-template-columns: 1fr; } }
  /* 30/09 (computador): título e frase à esquerda, formulário à direita; a seção cabe numa tela */
  @media (min-width: 1024px) {
    .contact .container { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(40px, 5vw, 80px); align-items: center; }
    .contact__head { justify-items: start; text-align: left; margin: 0; gap: 24px; }
    .contact__title { font-size: clamp(34px, 3.3vw, 48px); }
    .contact__card { grid-template-columns: 1fr; gap: 24px; }
  }
  @media (max-width: 767px) { .contact__head .btn { width: 100%; max-width: 360px; } }
</style>
