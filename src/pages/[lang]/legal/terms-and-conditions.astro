---
// Central de documentos legais: recriada com o texto do site atual (borespot.com/xx/legal/terms-and-conditions).
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { LANGS, href } from '../../../data/site.js';
import { getT } from '../../../i18n/index.js';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const t = getT(lang);
const L = t.legal;
const docUrl = (d) => href(lang, `/legal/${d.slug}`);
---
<Base lang={lang} t={t} path="/legal/terms-and-conditions" title={L.meta.title} description={L.meta.description}>
  <section class="section section--dark legal-hero" aria-labelledby="legal-title">
    <div class="container legal-hero__inner">
      <h1 class="h1 legal-hero__title" id="legal-title">{L.title}</h1>
      <p class="lead">{L.lead}</p>
      <p class="legal-hero__select">{L.select}</p>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="legal-current">
    <div class="container">
      <div class="section-head"><h2 class="h2" id="legal-current">{L.currentTitle}</h2></div>
      <ol class="legal-docs">
        {L.docs.map((d, i) => (
          <li class="legal-doc">
            <span class="legal-doc__n mono">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3 legal-doc__title">{d.title}</h3>
            <dl class="legal-doc__meta">
              <div><dt>{L.versionLabel}</dt><dd>{d.version}</dd></div>
              <div><dt>{L.effectiveLabel}</dt><dd>{d.effective}</dd></div>
            </dl>
            <a class="btn btn--outline legal-doc__btn" href={docUrl(d)}>{L.view}<Icon name="arrow" /></a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="legal-history">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="legal-history">{L.historyTitle}</h2>
        <p class="lead">{L.historyLead}</p>
      </div>
      <div class="legal-history">
        {L.docs.map((d) => (
          <div class="legal-history__row">
            <p class="legal-history__title">{d.title}</p>
            <span class="legal-history__tag mono">{L.current}</span>
            <p class="legal-history__meta">{L.versionWord} {d.version} · {d.effective}</p>
            <a href={docUrl(d)}>{L.view}</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .legal-hero { padding-top: calc(var(--nav-h) + clamp(56px, 8vw, 112px)); }
  .legal-hero__inner { display: grid; gap: 18px; max-width: 820px; }
  .legal-hero__title { font-size: clamp(30px, 4.6vw, 60px); }
  .legal-hero__select { color: var(--on-dark-2); }
  .legal-docs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .legal-doc { border: 1px solid var(--border); border-radius: var(--r); padding: 24px; display: grid; gap: 14px; align-content: start; transition: border-color .2s, box-shadow .2s; }
  .legal-doc:hover { border-color: var(--primary); box-shadow: 0 8px 30px rgba(15, 23, 41, .08); }
  .legal-doc__n { font-size: 13px; font-weight: 700; letter-spacing: .12em; color: var(--primary); }
  .legal-doc__title { font-size: 20px; }
  .legal-doc__meta { display: grid; gap: 4px; font-size: 14px; color: var(--text-2); }
  .legal-doc__meta div { display: flex; gap: 6px; }
  .legal-doc__meta dt { font-weight: 500; }
  .legal-doc__btn { justify-self: start; margin-top: 6px; }
  .legal-history { display: grid; border-top: 1px solid var(--border); }
  .legal-history__row { display: grid; grid-template-columns: 1fr auto auto auto; gap: 20px; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--border); }
  .legal-history__title { font-weight: 700; }
  .legal-history__tag { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #1B7F46; background: rgba(46, 204, 113, .14); padding: 3px 8px; border-radius: var(--r); }
  .legal-history__meta { color: var(--text-2); font-size: 14px; }
  .legal-history__row a { font-weight: 700; color: var(--primary); text-decoration: none; }
  @media (max-width: 1023px) { .legal-docs { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 767px) {
    .legal-docs { grid-template-columns: 1fr; }
    .legal-history__row { grid-template-columns: 1fr auto; gap: 6px 12px; }
    .legal-history__meta { grid-column: 1; }
  }
</style>
