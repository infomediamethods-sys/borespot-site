---
// Cada documento legal, no mesmo endereço do site atual (/xx/legal/<slug>).
// No site atual o texto dos documentos é em inglês nas 3 línguas (só título e rótulos mudam), então o texto vem sempre de src/content/legal/en/<slug>.md.
// Documentos marcados pending ainda não têm texto publicado no site atual: a página mostra o mesmo aviso de lá.
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { LANGS, href } from '../../../data/site.js';
import { getT } from '../../../i18n/index.js';

const files = import.meta.glob('/src/content/legal/en/*.md', { eager: true });

export function getStaticPaths() {
  return LANGS.flatMap((lang) => getT(lang).legal.docs.map((d) => ({ params: { lang, doc: d.slug } })));
}
const { lang, doc } = Astro.params;
const t = getT(lang);
const L = t.legal;
const d = L.docs.find((x) => x.slug === doc);
const file = d.pending ? null : files[`/src/content/legal/en/${doc}.md`];
const Content = file ? file.Content : null;
---
<Base lang={lang} t={t} path={`/legal/${doc}`} title={`${d.title} | BoreSpot`} description={L.meta.description}>
  <section class="section section--dark legal-hero" aria-labelledby="doc-title">
    <div class="container legal-hero__inner">
      <a class="legal-back mono" href={href(lang, '/legal/terms-and-conditions')}><Icon name="arrow" size={16} />{L.back}</a>
      <h1 class="h2" id="doc-title">{d.title}</h1>
      <p class="legal-hero__meta mono">{L.versionWord} {d.version} · {L.effectiveLabel} {d.effective}</p>
    </div>
  </section>
  <section class="section section--white">
    <div class="container">
      {Content ? (
        <article class="legal-body" lang="en"><Content /></article>
      ) : (
        <p class="legal-body legal-pending">{L.pendingText}</p>
      )}
      <p class="legal-foot"><a class="legal-back legal-back--dark mono" href={href(lang, '/legal/terms-and-conditions')}><Icon name="arrow" size={16} />{L.back}</a></p>
    </div>
  </section>
</Base>

<style>
  .legal-hero { padding-top: calc(var(--nav-h) + clamp(48px, 7vw, 96px)); }
  .legal-hero__inner { display: grid; gap: 16px; max-width: 820px; }
  .legal-back { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--sky); text-decoration: none; }
  .legal-back :global(svg) { transform: rotate(180deg); }
  .legal-back--dark { color: var(--primary); }
  .legal-foot { margin-top: 48px; }
  .legal-hero__meta { font-size: 13px; color: var(--on-dark-2); letter-spacing: .04em; }
  .legal-body { max-width: 760px; color: var(--text); font-size: 17px; line-height: 1.7; }
  .legal-pending { color: var(--text-2); }
  .legal-body :global(h2) { font-size: clamp(22px, 2.2vw, 28px); font-weight: 700; letter-spacing: -0.01em; line-height: 1.2; margin: 48px 0 14px; }
  .legal-body :global(h3) { font-size: 19px; font-weight: 700; margin: 32px 0 10px; }
  .legal-body :global(p), .legal-body :global(ul), .legal-body :global(ol) { margin: 0 0 16px; }
  .legal-body :global(ul) { list-style: disc; padding-left: 1.4em; }
  .legal-body :global(ol) { list-style: decimal; padding-left: 1.4em; }
  .legal-body :global(li) { margin-bottom: 6px; }
  .legal-body :global(a) { color: var(--primary); }
  .legal-body :global(strong) { font-weight: 700; }
</style>
